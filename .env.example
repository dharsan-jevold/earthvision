# Backend
ENV=development

# Auth/database (Phase 17 — wired in, these are optional overrides)
EARTHVISION_SECRET_KEY=change-me-in-production
DATABASE_URL=sqlite:///./earthvision.db
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Swap to Postgres/PostGIS by changing DATABASE_URL, e.g.:
# DATABASE_URL=postgresql+psycopg2://earthvision:change_me@localhost:5432/earthvision

# Real satellite providers (Phase 3 extension — not required for demo mode)
# COPERNICUS_CLIENT_ID=
# COPERNICUS_CLIENT_SECRET=
# NASA_EARTHDATA_TOKEN=
# GOOGLE_EARTH_ENGINE_SERVICE_ACCOUNT_JSON=

# Async stack (Phase 22 — not yet wired in)
# REDIS_URL=redis://localhost:6379/0

# Frontend
VITE_API_BASE=http://localhost:8000/api
