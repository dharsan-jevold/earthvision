# Local environment files and secrets. Keep example templates in Git.
.env
.env.*
!.env.example
!.env.*.example
frontend/.env
frontend/.env.*
!frontend/.env.example
!frontend/.env.*.example

# Python environments, bytecode, packaging, and test output.
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
build/

# Node/Vite output and package-manager logs.
node_modules/
dist/
dist-ssr/
.vite/
.turbo/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Local databases and SQLite sidecar files.
*.db
*.sqlite
*.sqlite3
*.db-wal
*.db-shm
*.sqlite-wal
*.sqlite-shm

# Research datasets, generated outputs, and trained model artifacts.
# Keep small, intentional demo fixtures under data/demo trackable.
data/*
!data/demo/
!data/demo/**
checkpoints/
runs/
outputs/
*.pt
*.pth
*.ckpt
*.onnx

# Logs, OS metadata, and editor settings.
*.log
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
